{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couple-travel-guide",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "couple-travel-guide",
      "database_id": "cc16ae0a-1449-448e-bc13-a8d5cf1df0fd"
    }
  ],
  "vars": {
    "SURFACE": "partner",
    "APP_ORIGIN": "https://couple-travel-guide.yeonuunim521.workers.dev",
    "GOOGLE_DRIVE_CLIENT_ID": "494144169808-nr0ncu3g27063ggte39i3s1mn5i4jtkv.apps.googleusercontent.com"
  }
}
